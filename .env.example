# 视觉模型配置（可选）：填好 API Key 后，控制台上传图片会自动识别画面内容并生成描述。
# 未配置时仍可用，控制台会退化为"文件名 + 拍摄时间 + 分辨率"的基础信息描述。
#
# 用法：
#   1. 复制本文件为 .env（.env 不会入库）；
#   2. 在 PULSE_VISION_API_KEY 后面填入你的 Key；
#   3. 双击「检查视觉模型.bat」自检，看到"结果：可用"即配置成功。

# ---- OpenCode Go（默认）----
PULSE_VISION_BASE_URL=https://opencode.ai/zen/go/v1
PULSE_VISION_API_STYLE=responses
PULSE_VISION_API_KEY=
PULSE_VISION_MODEL=deepseek-v4.1-flash
# 单次调用的超时（秒）。11MB 实拍图实测就要 13 秒，网络慢会更久，
# 建议不要低于 90，否则大图容易超时退回、导致入不了库。
PULSE_VISION_TIMEOUT=90
# OpenCode Go 强制要求该请求头，留空会自动用默认值；一般不用改。
PULSE_VISION_SESSION=pulse-media-library
# 单次识别的输出上限（**含模型的思考过程**）。
# 实测 12 张真实图：思考平均 680、最多 1199 token，输出最多 1429。
# 旧默认值 2,000 只剩不到 40% 余量；复杂画面一旦越界，思考会吃光额度、
# 正文一个字都出不来，表现就是"识别未完成、不能入库"。
# 注意：这只是上限不是收费项，调大不会增加正常调用的成本。
PULSE_VISION_MAX_TOKENS=4000
# 短文生成的输出上限。短文比描述长得多，且模型会先"思考"占掉大量预算，
# 沿用上面那档 2,000 会被截断成"返回内容不是 JSON"。默认 8,000。
PULSE_CAPTION_MAX_TOKENS=8000

# ---- 入库许可 ----
# 1 = 必须先完成视觉识别才允许入库（默认；识别没成功时控制台按钮是灰色不可点的）。
#     视觉模型不可用时会连素材都入不了库——这是刻意的：宁可挡住，也不让未经
#     识别的素材混进 RAG 知识库。
# 0 = 应急放行，未经识别的图也能入库（只在视觉服务长时间故障时临时用）。
PULSE_MEDIA_REQUIRE_VISION=1

# ---- 导出目录 ----
# 召回结果导出成的素材包落在哪里。留空则默认放在素材库旁边的
# `菲美得产品图片/../Pulse导出/`（老板容易找到）。也可以指定绝对路径。
PULSE_EXPORT_DIR=

# ---- 注意事项 ----
# 1. 识图必须用支持图片输入的模型：deepseek-v4.1-flash（推荐）或
#    deepseek-v4-flash-vision-exp（备选）。
#    deepseek-v4-flash / deepseek-v4-pro / deepseek-flash 不能识图——它们只有文本输入能力，
#    而且只在中国区托管、需要先显式开通，配了会直接报错。
# 2. 如改用其它 OpenAI 兼容服务，把 PULSE_VISION_API_STYLE 改成 chat（走 /chat/completions），
#    Responses 风格（本默认）走 /responses。
